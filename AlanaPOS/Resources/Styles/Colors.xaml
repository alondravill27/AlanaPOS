<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════
         PALETA ROSA — AlanaPOS
    ════════════════════════════════════════════ -->
    <Color x:Key="Primary">#993556</Color>
    <Color x:Key="PrimaryDark">#72243E</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#D4537E</Color>
    <Color x:Key="SecondaryDarkText">#E6E4F0</Color>

    <Color x:Key="PinkPrimary">#993556</Color>
    <Color x:Key="PinkDark">#72243E</Color>
    <Color x:Key="PinkMid">#D4537E</Color>
    <Color x:Key="PinkLight">#F4C0D1</Color>
    <Color x:Key="PinkBg">#FDF2F6</Color>
    <Color x:Key="PinkSurface">#FBEAF0</Color>

    <Color x:Key="Magenta">#D4537E</Color>
    <Color x:Key="MidnightBlue">#72243E</Color>
    <Color x:Key="OffBlack">#221B3D</Color>

    <!-- ═══════════════════════════════════════════
         ESTADOS
    ════════════════════════════════════════════ -->
    <Color x:Key="Success">#27500A</Color>
    <Color x:Key="SuccessBg">#EAF3DE</Color>
    <Color x:Key="Warning">#633806</Color>
    <Color x:Key="WarningBg">#FAEEDA</Color>
    <Color x:Key="Danger">#791F1F</Color>
    <Color x:Key="DangerBg">#FCEBEB</Color>

    <!-- ═══════════════════════════════════════════
         NEUTROS
    ════════════════════════════════════════════ -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="TextMuted">#888780</Color>

    <Color x:Key="Gray100">#F3F2F8</Color>
    <Color x:Key="Gray200">#E6E4F0</Color>
    <Color x:Key="Gray300">#D4D1E5</Color>
    <Color x:Key="Gray400">#B6B1D2</Color>
    <Color x:Key="Gray500">#888780</Color>
    <Color x:Key="Gray600">#5A557A</Color>
    <Color x:Key="Gray900">#221B3D</Color>
    <Color x:Key="Gray950">#120E24</Color>

</ResourceDictionary>
